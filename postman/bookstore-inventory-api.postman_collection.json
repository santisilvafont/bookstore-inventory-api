              "mode": "raw",
              "raw": "{\n  \"title\": \"Libro con errores\",\n  \"author\": \"Anónimo\",\n  \"isbn\": \"978-84-376-0494-0\",\n  \"cost_usd\": 0,\n  \"stock_quantity\": -1,\n  \"category\": \"Pruebas\",\n  \"supplier_country\": \"ZZ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Usa el formato de error de la API', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(400);",
                  "    pm.expect(body.code).to.eql('invalid');",
                  "    pm.expect(body.detail).to.be.a('string');",
                  "    pm.expect(body.errors).to.have.property('isbn');",
                  "    pm.expect(body.errors).to.have.property('cost_usd');",
                  "    pm.expect(body.errors).to.have.property('stock_quantity');",
                  "    pm.expect(body.errors).to.have.property('supplier_country');",
                  "});"
                ]
              }
            }
