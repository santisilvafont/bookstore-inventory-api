# Optional: copy to .env and edit to override the development defaults
# (defined in compose.yaml and backend/config/settings.py).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore

# Load the sample catalog on startup when the inventory is empty.
SEED_SAMPLE_DATA=true

EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_API_TIMEOUT=5
EXCHANGE_RATE_CACHE_SECONDS=3600
